layout {
    gaps 12
    center-focused-column "on-overflow"
    default-column-width { proportion 0.5; }
    focus-ring {
        width 3
        active-color "#00e5ff"
        inactive-color "#34304a"
    }
    border {
        width 2
        active-color "#ff2a9d"
        inactive-color "#242033"
    }
}
